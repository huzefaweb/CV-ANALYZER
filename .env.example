# Copy to .env and fill in real values. Never commit .env (already gitignored).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Auth0 adapter (AD-21): absent by default in V1 — presence of all three
# selects the Auth0 adapter over the local email/password adapter. Leave
# empty until Story 1.2's deferred Auth0 preflight is re-run.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Analysis-provider adapter (AD-22): OLLAMA_HOST has a working default
# (http://ollama:11434 inside docker compose) and rarely needs overriding.
# OLLAMA_MODEL defaults to qwen2.5:0.5b-instruct (the AF-13-pinned model,
# already pulled by the standard setup) if left blank. Pull a larger tag
# first (`docker compose exec ollama ollama pull qwen2.5:14b-instruct`)
# before pointing this at it — this only selects a model, it does not pull
# one. Presence of all four AZURE_OPENAI_* vars below selects the Azure
# OpenAI adapter over the local Ollama adapter. Leave empty until Story
# 1.3's deferred Azure OpenAI preflight is re-run.
OLLAMA_HOST=
OLLAMA_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
